From 93b92a45c4362e25c3c03d422cbf8452d7be11bd Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Sat, 3 Oct 2026 12:02:25 +0200
Subject: [PATCH] Add opt-in CPU proxy producer and completion diagnostics

---
 src/doca_gpunetio.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/doca_gpunetio.cpp b/src/doca_gpunetio.cpp
index ba68cd8..0906f46 100644
--- a/src/doca_gpunetio.cpp
+++ b/src/doca_gpunetio.cpp
@@ -1335,6 +1335,17 @@ doca_error_t doca_gpu_verbs_cpu_proxy_progress(struct doca_gpu_verbs_qp *qp, boo
     bool qp_progressed = false;
     if (qp == nullptr) return DOCA_ERROR_INVALID_VALUE;
 
+    // Opt-in setup diagnostic, deliberately excluded from latency measurements.
+    static const bool trace_progress = getenv("GPUNETIO_TRACE_PROGRESS") != nullptr;
+    static thread_local uint64_t trace_polls = 0;
+    if (trace_progress && ((trace_polls++ & ((1U << 22) - 1)) == 0)) {
+        auto *cqe = reinterpret_cast<struct doca_gpunetio_ib_mlx5_cqe64 *>(qp->qp_cpu->cq_sq.cqe_daddr);
+        fprintf(stderr, "GPU_PROGRESS pi=%llu last=%llu cq=%08x\n",
+                (unsigned long long)*reinterpret_cast<volatile uint64_t *>(qp->cpu_db),
+                (unsigned long long)qp->sq_wqe_pi_last,
+                be32toh(*reinterpret_cast<volatile uint32_t *>(&cqe->wqe_counter_sig_op_own_raw)));
+    }
+
     if (qp->cq_type == DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST) {
         priv_cpu_proxy_progress_cq(qp, &cq_progressed);
     }
